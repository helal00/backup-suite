[Unit]
Description=Backup Suite file backup
After=network-online.target
Wants=network-online.target
# The resource watchdog runs only while this backup runs.
Wants=backup-suite-watchdog@file-backup.service
OnFailure=backup-suite-notify@%n.service

[Service]
Type=exec
__USER_GROUP_DIRECTIVES__
Environment=BACKUP_SUITE_CONFIG_DIR=__CONFIG_DIR__
Environment=BACKUP_SUITE_FILE_BACKUP_MODE=normal
EnvironmentFile=-/run/backup-suite/file-backup.env
RuntimeDirectory=backup-suite
ExecStart=__INSTALL_DIR__/bin/file-backup-service.sh __LOCK_FILE__
SuccessExitStatus=SIGTERM 75
OOMPolicy=stop
Restart=no
TimeoutStartSec=infinity
TimeoutStopSec=2min
RuntimeMaxSec=__FILE_BACKUP_RUNTIME_MAX_SEC__
KillMode=control-group
CPUAccounting=true
MemoryAccounting=true
IOAccounting=true
CPUQuota=50%
CPUWeight=10
IOWeight=10
Nice=15
IOSchedulingClass=idle
MemoryHigh=512M
MemoryMax=1G
MemorySwapMax=256M
TasksMax=64
StandardOutput=journal
StandardError=journal
SyslogIdentifier=backup-file
