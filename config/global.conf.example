## Example configuration for public use.
## Copy this file to global.conf and update the values for your own host.

INSTALL_MODE="auto"

SYSTEM_INSTALL_DIR="/opt/backup-suite"
SYSTEM_CANONICAL_SOURCE_DIR="/opt/backup-suite-src"
SYSTEM_CONFIG_DIR="/etc/backup-suite"
SYSTEM_STATE_DIR="/var/lib/backup-suite"
SYSTEM_DB_LOCAL_OUTPUT_DIR="/var/backups/backup-suite/databases"
SYSTEM_RCLONE_CONFIG_PATH="/etc/backup-suite/rclone.conf"
SYSTEM_RCLONE_BIN="rclone"
SYSTEM_FILE_SOURCE_CONFIG_PATH="/etc/backup-suite/file-sources.conf"
SYSTEM_DATABASE_BACKUP_CONFIG_PATH="/etc/backup-suite/database-backups.conf"
SYSTEM_MYSQL_PROFILE_DIR="/etc/backup-suite/mysql-profiles"
SYSTEM_SYSTEMD_UNIT_DIR="/etc/systemd/system"

USER_INSTALL_DIR="$HOME/.local/share/backup-suite"
USER_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/backup-suite"
USER_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/backup-suite"
USER_DB_LOCAL_OUTPUT_DIR="$HOME/backups/backup-suite/databases"
USER_RCLONE_CONFIG_PATH="${XDG_CONFIG_HOME:-$HOME/.config}/backup-suite/rclone.conf"
USER_RCLONE_BIN="rclone"
USER_FILE_SOURCE_CONFIG_PATH="${XDG_CONFIG_HOME:-$HOME/.config}/backup-suite/file-sources.conf"
USER_DATABASE_BACKUP_CONFIG_PATH="${XDG_CONFIG_HOME:-$HOME/.config}/backup-suite/database-backups.conf"
USER_MYSQL_PROFILE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/backup-suite/mysql-profiles"

RCLONE_REMOTE_ROOT="gdrive,root_folder_id=REPLACE_ME:server-backups"
INCLUDE_HOSTNAME_IN_REMOTE="1"
REMOTE_HOSTNAME=""

FILE_DEFAULT_DESTINATION_ROOT="files"
FILE_ARCHIVE_FOLDER_NAME="deleted_files"
FILE_ARCHIVE_SUFFIX="_old"
FILE_RETENTION_DAYS="21d"
FILE_SYNC_STOP_FILE=".nosync"
# Folders a backup job may back up (the GUI's job editor refuses anything else, and
# always refuses system folders and Backup Suite's own). Only set here, on the server.
FILE_JOB_SOURCE_ROOTS="/home /var/www /srv /opt"
FILE_PROJECT_EXCLUDE_FILENAME=".backup-excludes"
# Explicit rebuildable AgentW runtime artifacts. Canonical .ai-metadata Markdown
# continuity files remain included.
FILE_GLOBAL_EXCLUDE_PATTERNS=".ai-metadata/observation-cache/**|.ai-metadata/.ready-observation-cache.*|.ai-metadata/ready-observation-cache.json|.ai-metadata/native-ready-cache/**|.ai-metadata/prompt-runs/**|.ai-metadata/terminal-choice-state.json"
FILE_VOLATILE_FILENAME=".backup-volatile"
# These paths remain backed up when stable. Only entries observed changing across
# the stability interval are preserved remotely and retried on the next run.
FILE_GLOBAL_VOLATILE_PATTERNS=".ai-metadata/chat-store/**|.ai-metadata/prompts/gui-autosave-*.prompt.txt|.ai-metadata/claude/current.json|.ai-metadata/claude/events/**"
FILE_PROCESS_CHECK_ENABLED="1"
FILE_PROCESS_CHECK_USER_ONLY="1"
FILE_PROCESS_CHECK_PATTERNS="vscode-server"
# Resource profile for file backups: slow, moderate, fast, or custom.
# Run "backup-profile.sh show" for the limits of each, "backup-profile.sh set <name>"
# for one fixed profile, or "backup-profile.sh adaptive <top> <floor>" to let the
# watchdog step down toward the floor when resources are tight and back up when
# they are normal (moderate>slow, or fast>moderate>slow).
# The FILE_RCLONE_* tuning below (and FILE_CUSTOM_* systemd limits) apply only to "custom".
FILE_BACKUP_PROFILE="moderate"
FILE_BACKUP_PROFILE_MODE="adaptive"
FILE_BACKUP_PROFILE_FLOOR="slow"
# "fixed" uses the built-in limits table; "auto" scales memory and CPU to this host
# (slow 5%/3%, moderate 10%/6%, fast 20%/12% of RAM / total CPU).
FILE_PROFILE_LIMITS_MODE="fixed"
# Optional per-profile overrides, e.g. (keys: backup-profile.sh --help):
# FILE_PROFILE_SLOW_MEMORY_MAX="384M"
# FILE_PROFILE_MODERATE_RCLONE_BWLIMIT="20M"
FILE_RCLONE_TRANSFERS="2"
FILE_RCLONE_CHECKERS="4"
FILE_RCLONE_BUFFER_SIZE="16M"
FILE_RCLONE_TPSLIMIT="10"
FILE_RCLONE_BWLIMIT=""
FILE_RCLONE_EXTRA_FLAGS=""
FILE_STABILITY_INTERVAL_SECONDS="10"
FILE_CHANGED_DETAIL_LIMIT="20"
# Changing-file tracking: files modified within FILE_ACTIVE_WINDOW_SECONDS, or
# seen changing during an upload, are kept away from rclone for that run. Their
# previous remote version stays in place and they are retried on the next run.
# A file deferred for FILE_ACTIVE_MAX_DEFERRALS runs in a row triggers an ntfy warning.
FILE_ACTIVE_TRACKING_ENABLED="1"
FILE_ACTIVE_WINDOW_SECONDS="120"
FILE_ACTIVE_MAX_DEFERRALS="12"
FILE_BACKUP_RUNTIME_MAX_SEC="6h"
FILE_BACKUP_ONCALENDAR="*:0/30"
FILE_BACKUP_RANDOMIZED_DELAY_SEC="15m"

BACKUP_SUITE_LOG_MAX_BYTES="10485760"
BACKUP_SUITE_LOG_KEEP_FILES="10"

DB_REMOTE_DESTINATION_ROOT="databases"
DB_RETENTION_DAYS="14"
DB_RCLONE_TRANSFERS="4"
DB_RCLONE_CHECKERS="8"
DB_RCLONE_EXTRA_FLAGS=""
DB_SKIP_UNCHANGED_BACKUPS="1"
DB_KEEP_LOCAL_AFTER_UPLOAD="1"
DB_BACKUP_ONCALENDAR="daily"
DB_MONITOR_THRESHOLD_MB="512"
DB_MONITOR_ONCALENDAR="daily"

NOTIFY_FAILURES_ENABLED="0"
NOTIFY_NTFY_TOPIC_URL=""
NOTIFY_NTFY_TITLE_PREFIX="Backup Suite"
NOTIFY_NTFY_PRIORITY="high"
NOTIFY_JOURNAL_LINES="40"
NOTIFY_DURABLE_LOG_LINES="120"
NOTIFY_FAILURE_LOG_KEEP_FILES="100"
# Optional ntfy access token for protected topics.
NOTIFY_NTFY_TOKEN=""
# Attach the full log to each alert (the readable description is always the message).
NOTIFY_NTFY_ATTACH_DETAILS="1"

# Resource watchdog (runs only while a backup runs). Percentages refer to the
# backup's MemoryMax unless they name the server.
WATCHDOG_INTERVAL_SECONDS="5"
WATCHDOG_CONTAIN_PERCENT="80"
WATCHDOG_CONTAIN_RELEASE_PERCENT="60"
WATCHDOG_KILL_PERCENT="90"
WATCHDOG_KILL_SAMPLES="2"
WATCHDOG_SWAP_CONTAIN_PERCENT="80"
WATCHDOG_SWAP_KILL_PERCENT="95"
WATCHDOG_SYSTEM_MIN_AVAILABLE_PERCENT="10"
WATCHDOG_SYSTEM_CRITICAL_AVAILABLE_PERCENT="4"
WATCHDOG_SYSTEM_PSI_FULL_LIMIT="20"
# A memory stall (PSI) pauses the backup only while RAM is also short; a stall
# caused by another service at its own memory limit never pauses it.
WATCHDOG_PSI_PAUSE_AVAILABLE_PERCENT="20"
# Never pause a backup holding less than this (non-reclaimable memory + swap).
WATCHDOG_PAUSE_MIN_FOOTPRINT_MB="64"
# Pressure must last this long before a pause or step-down.
WATCHDOG_PRESSURE_SUSTAIN_SECONDS="30"
WATCHDOG_FREEZE_MAX_SECONDS="900"
# After a long pause the backup is stopped, then retried once memory has been
# normal for WATCHDOG_RETRY_CLEAR_SECONDS (0 = leave it to the next timer run).
WATCHDOG_RETRY_WAIT_SECONDS="1800"
WATCHDOG_RETRY_CLEAR_SECONDS="60"
WATCHDOG_KILL_GRACE_SECONDS="30"
WATCHDOG_TASKS_WARN_PERCENT="90"
# Adaptive profile stepping (FILE_BACKUP_PROFILE_MODE="adaptive").
WATCHDOG_ADAPTIVE_STEP_DOWN_AVAILABLE_PERCENT="20"
WATCHDOG_ADAPTIVE_STEP_DOWN_PSI_FULL="10"
WATCHDOG_ADAPTIVE_STEP_UP_AVAILABLE_PERCENT="30"
WATCHDOG_ADAPTIVE_STEP_UP_SECONDS="300"
WATCHDOG_ADAPTIVE_COOLDOWN_SECONDS="120"
# Push step-down/step-up notices too (otherwise they are only listed as events).
WATCHDOG_NOTIFY_PROFILE_STEPS="0"

INSTALL_SYSTEMD_UNITS="1"
ENABLE_TIMERS_AFTER_INSTALL="0"
